{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",

    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],

    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",

    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["./*"],

      "@components/*": ["./components/*"],
      "@shadcn/*": ["./components/ui/*"],
      "@lib/*": ["./lib/*"],
      "@hooks/*": ["hooks/*"],
      "@nxf/*": ["nxf-ui/*"]
    },

    "plugins": [
      {
        "name": "next"
      }
    ],

    "allowJs": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },

  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "hooks/**/*",
    "nxf-ui/**/*",
    ".next/types/**/*.ts"
, "server/getSystemConfig.ts"  ],

 "exclude": [
    "node_modules",
     ".next"
  ]
}