      "nullable": false,
      "default": "active",
      "description": "active, suspended, deleted"
    },
    {
      "name": "last_active_at",
      "type": "datetime",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true
    }
