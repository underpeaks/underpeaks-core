  "indexes": [
    {
      "name": "idx_profiles_user",
      "fields": ["user_id"]
    },
    {
      "name": "idx_profiles_username",
      "fields": ["username"]
    },
    {
      "name": "idx_profiles_org",
      "fields": ["organisation_id"]
    },
    {
      "name": "idx_profiles_status",
      "fields": ["status"]
    }
  ],
  "constraints": [
    {
      "type": "unique",
      "fields": ["user_id"]
    },
    {
      "type": "unique",
      "fields": ["username"]
    }
  ]
