    {
      "name": "display_name",
      "type": "string",
      "nullable": true
    },
    {
      "name": "bio",
      "type": "text",
      "nullable": true
    },
    {
      "name": "avatar_url",
      "type": "string",
      "nullable": true
    },
    {
      "name": "cover_image_url",
      "type": "string",
      "nullable": true
    },
    {
      "name": "website_url",
      "type": "string",
      "nullable": true
    },
    {
      "name": "location",
      "type": "string",
      "nullable": true
    },
    {
      "name": "phone_number",
      "type": "string",
      "nullable": true
    },
    {
      "name": "email",
      "type": "string",
      "nullable": true
    },
    {
      "name": "date_of_birth",
      "type": "date",
      "nullable": true
    },
    {
      "name": "gender",
      "type": "string",
      "nullable": true
    },
    {
      "name": "is_verified",
      "type": "boolean",
      "nullable": false,
      "default": false
    },
    {
      "name": "follower_count",
      "type": "integer",
      "nullable": false,
      "default": 0
    },
    {
      "name": "following_count",
      "type": "integer",
      "nullable": false,
      "default": 0
    },
    {
      "name": "post_count",
      "type": "integer",
      "nullable": false,
      "default": 0
    },
    {
      "name": "account_type",
      "type": "string",
