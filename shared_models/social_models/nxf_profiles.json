      "nullable": false,
      "description": "linked to nxf_saas_users.user_id"
    },
    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "optional SaaS tenant scope"
    },
    {
      "name": "username",
      "type": "string",
      "nullable": false
