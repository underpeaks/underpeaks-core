      "hidden": true
    },
    {
      "name": "user_id",
      "type": "string",
      "nullable": false,
      "description": "author of the post",
      "hidden": true
    },
    {
      "name": "group_id",
      "type": "string",
      "nullable": true,
      "description": "optional group post",
      "hidden": true
    },
    {
      "name": "post_type",
