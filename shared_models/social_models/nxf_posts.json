      "type": "boolean",
      "nullable": false,
      "default": false,
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "is_edited",
      "type": "boolean",
      "nullable": false,
      "default": false,
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "edited_at",
