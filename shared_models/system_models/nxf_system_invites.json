{
  "table_name": "nxf_system_invites",
  "schema": "public",
  "columns": {
    "si_id": {
      "type": "string",
      "default": "gen_random_uuid()",
      "is_primary": true,
      "nullable": false,
      "hidden": true
    },
   "tenant_id": {
  "type": "string",
  "nullable": false,
  "foreign_key": {
    "references": "nxf_system_tenants(ten_id)",
    "on_delete": "CASCADE"
  },
  "hidden": true
},
"project_id": { "type": "string", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" }, "hidden": true },
    "email": {
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "email-input"
    },
    "role": {
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["owner", "admin", "developer", "viewer"]
    },
    "token": {
      "type": "string",
      "nullable": false,
      "hidden": true
    },
    "accepted_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "created_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "default": "now()",
      "hidden": true
    }
  },
  "constraints": {
    "primary_key": ["si_id"]
  }
}