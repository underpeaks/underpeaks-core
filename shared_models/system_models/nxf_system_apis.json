{
  "table_name": "nxf_system_apis",
  "schema": "public",
  "columns": {
    "api_id": {
      "type": "string",
      "default": "gen_random_uuid()",
      "is_primary": true,
      "nullable": false,
      "hidden": true
    },
   "tenant_id": {
  "type": "string",
  "nullable": false,
  "foreign_key": {
    "references": "nxf_system_tenants(ten_id)",
    "on_delete": "CASCADE"
  },
  "hidden": true
},
"project_id": { "type": "string", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" }, "hidden": true },
    "name": {
      "type": "string",
      "nullable": false,
      "description": "Human readable label e.g. Production Key",
      "hidden": false,
      "ui_type": "textfield"
    },
    "key_encrypted": {
      "type": "string",
      "nullable": false,
      "description": "AES-256-GCM encrypted full API key",
      "hidden": true
    },
    "key_prefix": {
      "type": "string",
      "nullable": false,
      "description": "First 16 chars shown in UI — safe to store plain",
      "hidden": false,
      "ui_type": "textfield"
    },
    "status": {
      "type": "string",
      "nullable": false,
      "default": "active",
      "description": "active, revoked",
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["active", "revoked"]
    },
    "rate_limit_count": {
      "type": "integer",
      "nullable": true,
      "default": "0",
      "description": "Requests made in the current rate-limit window",
      "hidden": true
    },
    "rate_limit_reset_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "description": "When the current rate-limit window resets",
      "hidden": true
    },
    "last_used_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "revoked_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "created_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "default": "now()",
      "hidden": true
    },
    "updated_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "default": "now()",
      "hidden": true
    }
  },
  "constraints": {
    "primary_key": ["api_id"]
  }
}