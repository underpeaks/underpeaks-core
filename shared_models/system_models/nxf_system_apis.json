{
  "table_name": "nxf_system_apis",
  "schema": "public",
  "columns": {
    "api_id": { "type": "uuid", "default": "gen_random_uuid()", "primary_key": true, "nullable": false },
    "project_id": { "type": "uuid", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" } },
    "name": { "type": "string", "nullable": false },
    "base_path": { "type": "string", "nullable": false },
    "version": { "type": "string", "nullable": true },
    "schema": { "type": "jsonb", "nullable": false },
    "created_at": { "type": "timestamp with time zone", "nullable": true, "default": "now()" },
    "updated_at": { "type": "timestamp with time zone", "nullable": true, "default": "now()" }
  },
  "constraints": {
    "primary_key": ["id"]
  }
}
