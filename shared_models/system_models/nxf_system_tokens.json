{
  "table_name": "nxf_system_tokens",
  "schema": "public",
  "columns": {
    "token_id": {
      "type": "string",
      "default": "gen_random_uuid()",
      "is_primary": true,
      "nullable": false,
      "hidden": true
    },
    "user_id": {
      "type": "string",
      "nullable": false,
      "foreign_key": {
        "references": "nxf_users(user_id)",
        "on_delete": "CASCADE"
      },
      "hidden": true
    },
   
"tenant_id": {
  "type": "string",
  "nullable": false,
  "foreign_key": {
    "references": "nxf_system_tenants(ten_id)",
    "on_delete": "CASCADE"
  },
  "hidden": true
},
"project_id": { "type": "string", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" }, "hidden": true },
    "access_token": {
      "type": "string",
      "nullable": false,
      "unique": true,
      "hidden": true
    },
    "refresh_token": {
      "type": "string",
      "nullable": false,
      "unique": true,
      "hidden": true
    },
    "token_type": {
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "select"
    },
    "expires_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "refresh_expires_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "ip_address": {
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "textfield"
    },
    "user_agent": {
      "type": "text",
      "nullable": true,
      "hidden": false,
      "ui_type": "textarea"
    },
    "revoked": {
      "type": "boolean",
      "nullable": false,
      "default": false,
      "hidden": false,
      "ui_type": "toggle"
    },
    "created_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "default": "now()",
      "hidden": true
    },
    "updated_at": {
      "type": "timestamp with time zone",
      "nullable": false,
      "default": "now()",
      "hidden": true
    }
  }
}