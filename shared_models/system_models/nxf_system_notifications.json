{
  "table_name": "nxf_system_notifications",
  "schema": "public",
  "columns": [
    { "name": "sn_id", "type": "string", "default": "gen_random_uuid()", "primary_key": true, "nullable": false },
    { "name": "user_id", "type": "string", "nullable": false, "foreign_key": { "references": "nxf_users(user_id)", "on_delete": "CASCADE" } },
    { "name": "title", "type": "string", "nullable": false },
    { "name": "body", "type": "string", "nullable": false },
    { "name": "is_read", "type": "boolean", "nullable": false, "default": "false" },
    { "name": "data", "type": "jsonb", "nullable": true },
    { "name": "created_at", "type": "timestamp with time zone", "nullable": false, "default": "now()" }
  ]
}
