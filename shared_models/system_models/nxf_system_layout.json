{
  "table_name": "nxf_system_layout",
  "schema": "public",
  "columns": {
    "sl_id": {
      "type": "string",
      "default": "gen_random_uuid()",
      "primary_key": true,
      "nullable": false
    },
    "project_id": {
      "type": "string",
      "nullable": false,
      "foreign_key": {
        "references": "nxf_system_projects(project_id)",
        "on_delete": "CASCADE"
      }
    },
    "name": {
      "type": "string",
      "nullable": false
    },
    "schema": {
      "type": "jsonb",
      "nullable": false
    },
    "created_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "default": "now()"
    },
    "updated_at": {
      "type": "timestamp with time zone",
      "nullable": true,
      "default": "now()"
    }
  },
  "constraints": {
    "primary_key": ["sl_id"]
  }
}
