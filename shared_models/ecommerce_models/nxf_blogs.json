{
  "table_name": "nxf_blogs",
  "primary_key": "blog_id",
  "columns": {
    "id": {
      "type": "string",
      "hidden": true
    },
    
"tenant_id": {
  "type": "string",
  "nullable": false,
  "foreign_key": {
    "references": "nxf_system_tenants(ten_id)",
    "on_delete": "CASCADE"
  },
  "hidden": true
},
"project_id": { "type": "string", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" }, "hidden": true },
    "title": {
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "textfield"
    },
    "slug": {
      "type": "string",
      "nullable": false,
      "unique": true,
      "hidden": false,
      "ui_type": "slug-input"
    },
    "content": {
      "type": "jsonb",
      "nullable": false,
      "hidden": false,
      "ui_type": "rich-text"
    },
    "author_id": {
      "type": "string",
      "nullable": false,
      "references": {
        "table": "users",
        "column": "user_id",
        "on_delete": "SET NULL"
      },
      "hidden": true
    },
    "categories": {
      "type": "array",
      "nullable": true,
      "hidden": false,
      "ui_type": "multi-select"
    },
    "tags": {
      "type": "array",
      "nullable": true,
      "hidden": false,
      "ui_type": "tags-input"
    },
    "published_at": {
      "type": "datetime",
      "nullable": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "status": {
      "type": "string",
      "nullable": false,
      "default": "draft",
      "enum": ["draft", "published", "archived"],
      "hidden": false,
      "ui_type": "select"
    },
    "created_at": {
      "type": "datetime",
      "required": true,
      "hidden": true
    },
    "updated_at": {
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  }
}