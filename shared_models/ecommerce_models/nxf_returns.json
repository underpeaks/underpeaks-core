{
  "table_name": "nxf_returns",
  "primary_key": "ret_id",
  "columns": {
    "ret_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "nullable": false,
      "references": {
        "table": "orders",
        "column": "ord_id",
        "on_delete": "CASCADE"
      }
    },
    "product_id": {
      "type": "string",
      "nullable": false,
      "references": {
        "table": "products",
        "column": "prod_id",
        "on_delete": "CASCADE"
      }
    },
    "product_variant_id": {
      "type": "string",
      "nullable": true,
      "references": {
        "table": "product_variants",
        "column": "pv_id",
        "on_delete": "SET NULL"
      }
    },
    "user_id": {
      "type": "string",
      "nullable": false,
      "references": {
        "table": "users",
        "column": "user_id",
        "on_delete": "SET NULL"
      }
    },
    "reason": {
      "type": "string",
      "nullable": false
    },
    "status": {
      "type": "string",
      "default": "pending",
      "nullable": false
    },
    "requested_at": {
      "type": "datetime",
      "nullable": false
    },
    "processed_at": {
      "type": "datetime",
      "nullable": true
    },
    "refund_amount": {
      "type": "double",
      "nullable": true
    },
    "created_at": {
      "type": "datetime",
      "required": true
    },
    "updated_at": {
      "type": "datetime",
      "nullable": true
    }
  }
}
