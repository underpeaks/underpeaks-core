{
  "table_name": "nxf_reviews",
  "primary_key": "rev_id",
  "columns": {
    "rev_id": {
      "type": "string",
      "hidden": true
    },
    "product_id": {
      "type": "string",
      "references": {
        "table": "products",
        "column": "prod_id",
        "on_delete": "CASCADE"
      },
      "hidden": true
    },
    "tenant_id": {
  "type": "string",
  "nullable": false,
  "foreign_key": {
    "references": "nxf_system_tenants(ten_id)",
    "on_delete": "CASCADE"
  },
  "hidden": true
},
"project_id": { "type": "string", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" }, "hidden": true },
    "product_variant_id": {
      "type": "string",
      "nullable": true,
      "references": {
        "table": "product_variants",
        "column": "pv_id",
        "on_delete": "CASCADE"
      },
      "hidden": true
    },
    "user_id": {
      "type": "string",
      "references": {
        "table": "users",
        "column": "user_id",
        "on_delete": "SET NULL"
      },
      "hidden": true
    },
    "rating": {
      "type": "double",
      "hidden": false,
      "ui_type": "number-input"
    },
    "title": {
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "textfield"
    },
    "comment": {
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "textarea"
    },
    "review_date": {
      "type": "datetime",
      "required": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "hidden": false,
      "ui_type": "toggle"
    },
    "created_at": {
      "type": "datetime",
      "required": true,
      "hidden": true
    },
    "updated_at": {
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  }
}