{
  "table_name": "nxf_reviews",
  "primary_key": "rev_id",
  "columns": {
    "rev_id": { "type": "string" },
    "product_id": {
      "type": "string",
      "references": {
        "table": "products",
        "column": "prod_id",
        "on_delete": "CASCADE"
      }
    },
    "product_variant_id": {
      "type": "string",
      "nullable": true,
      "references": {
        "table": "product_variants",
        "column": "pv_id",
        "on_delete": "CASCADE"
      }
    },
    "user_id": {
      "type": "string",
      "references": {
        "table": "users",
        "column": "user_id",
        "on_delete": "SET NULL"
      }
    },
    "rating": { "type": "double" },           
    "title": { "type": "string", "nullable": true },
    "comment": { "type": "string", "nullable": true },
    "review_date": { "type": "datetime", "required": true },
    "approved": { "type": "boolean", "default": false },
    "created_at": { "type": "datetime", "required": true },
    "updated_at": { "type": "datetime", "nullable": true }
  }
}
