{
  "table_name": "nxf_integrations",
  "schema": "public",
  "columns": [
    {
      "name": "integration_id",
      "type": "string",
      "nullable": false,
      "is_primary": true,
      "hidden": true
    },
     {
    "name": "project_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_projects(project_id)"
    },
    "hidden": true
  },
  {
    "name": "tenant_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_tenants(ten_id)"
    },
    "hidden": true
  },
    {
      "name": "name",
      "type": "string",
      "nullable": false,
      "description": "e.g. Stripe, PayFast, WhatsApp, Firebase, Shopify, DHL",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "int_key",
      "type": "string",
      "nullable": false,
      "description": "unique identifier like 'stripe', 'payfast', 'whatsapp_api'",
      "hidden": false,
      "ui_type": "slug-input"
    },
    {
      "name": "type",
      "type": "string",
      "nullable": false,
      "description": "payment, shipping, messaging, auth, analytics, storage, ai",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "provider",
      "type": "string",
      "nullable": true,
      "description": "external provider name if different from integration name",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "is_active",
      "type": "boolean",
      "nullable": false,
      "default": true,
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "is_required",
      "type": "boolean",
      "nullable": false,
      "default": false,
      "description": "core integrations required for system operation",
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "config_schema",
      "type": "jsonb",
      "nullable": true,
      "default": "{}",
      "description": "Defines required config fields (api keys, secrets, endpoints)",
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "default_config",
      "type": "jsonb",
      "nullable": true,
      "default": "{}",
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "is_multi_tenant",
      "type": "boolean",
      "nullable": false,
      "default": true,
      "description": "whether each vendor has their own config instance",
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "supports_webhooks",
      "type": "boolean",
      "nullable": false,
      "default": false,
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "webhook_url_template",
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "url-input"
    },
    {
      "name": "rate_limit_per_minute",
      "type": "int",
      "nullable": true,
      "hidden": false,
      "ui_type": "number-input"
    },
    {
      "name": "status",
      "type": "string",
      "nullable": false,
      "default": "active",
      "description": "active, deprecated, beta, disabled",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "documentation_url",
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "url-input"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "hidden": true
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  ],
  "indexes": [
    {
      "name": "idx_integrations_key",
      "fields": ["int_key"]
    },
    {
      "name": "idx_integrations_type",
      "fields": ["type"]
    }
  ],
  "constraints": [
    {
      "type": "unique",
      "fields": ["int_key"]
    }
  ]
}