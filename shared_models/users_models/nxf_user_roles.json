    {
      "name": "assigned_at",
      "type": "datetime",
      "nullable": false
    },
    {
      "name": "expires_at",
      "type": "datetime",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true
    }
