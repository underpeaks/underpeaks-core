{
  "table_name": "nxf_notifications",
  "schema": "public",
  "columns": [
    {
      "name": "notification_id",
      "type": "string",
      "nullable": false,
      "is_primary": true,
      "hidden": true
    },
  {
    "name": "project_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_projects(project_id)"
    },
    "hidden": true
  },
  {
    "name": "tenant_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_tenants(ten_id)"
    },
    "hidden": true
  },

    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "optional tenant scope (null = global/system)",
      "hidden": true
    },
    {
      "name": "recipient_user_id",
      "type": "string",
      "nullable": false,
      "description": "user who receives the notification",
      "hidden": true
    },
    {
      "name": "actor_user_id",
      "type": "string",
      "nullable": true,
      "description": "user who triggered the notification (if applicable)",
      "hidden": true
    },
    {
      "name": "type",
      "type": "string",
      "nullable": false,
      "description": "comment, like, follow, system, payment, security, message",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "title",
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "message",
      "type": "text",
      "nullable": true,
      "hidden": false,
      "ui_type": "textarea"
    },
    {
      "name": "entity_type",
      "type": "string",
      "nullable": true,
      "description": "related entity (post, comment, order, etc.)",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "entity_id",
      "type": "string",
      "nullable": true,
      "hidden": true
    },
    {
      "name": "action_url",
      "type": "string",
      "nullable": true,
      "description": "deep link / frontend route",
      "hidden": false,
      "ui_type": "url-input"
    },
    {
      "name": "priority",
      "type": "string",
      "nullable": false,
      "default": "normal",
      "description": "low, normal, high, urgent",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "status",
      "type": "string",
      "nullable": false,
      "default": "unread",
      "description": "unread, read, archived, deleted",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "channel",
      "type": "string",
      "nullable": false,
      "default": "in_app",
      "description": "in_app, email, sms, push, webhook",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "metadata",
      "type": "jsonb",
      "nullable": true,
      "default": "{}",
      "description": "extra payload (avatars, counters, custom data)",
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "read_at",
      "type": "datetime",
      "nullable": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "hidden": true
    }
  ],
  "indexes": [
    { "name": "idx_notifications_recipient", "fields": ["recipient_user_id"] },
    { "name": "idx_notifications_type", "fields": ["type"] },
    { "name": "idx_notifications_status", "fields": ["status"] },
    { "name": "idx_notifications_entity", "fields": ["entity_type", "entity_id"] },
    { "name": "idx_notifications_created", "fields": ["created_at"] }
  ],
  "constraints": [
    {
      "type": "foreign_key",
      "fields": ["recipient_user_id"],
      "references": { "table": "nxf_users", "field": "user_id" }
    },
    {
      "type": "foreign_key",
      "fields": ["project_id"],
      "references": { "table": "nxf_system_projects", "field": "project_id" }
    }
  ]
}