{
  "table_name": "nxf_notifications",
  "schema": "public",
  "columns": [
    {
      "name": "notification_id",
      "type": "string",
      "nullable": false,
      "is_primary": true
    },
    {
      "name": "project_id",
      "type": "string",
      "nullable": false,
      "is_primary": false
    },
    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "optional tenant scope (null = global/system)"
    },
    {
      "name": "recipient_user_id",
      "type": "string",
      "nullable": false,
      "description": "user who receives the notification"
    },
    {
      "name": "actor_user_id",
      "type": "string",
      "nullable": true,
      "description": "user who triggered the notification (if applicable)"
    },
    {
      "name": "type",
      "type": "string",
      "nullable": false,
      "description": "comment, like, follow, system, payment, security, message"
    },
    {
      "name": "title",
      "type": "string",
      "nullable": false
    },
    {
      "name": "message",
      "type": "text",
      "nullable": true
    },
    {
      "name": "entity_type",
      "type": "string",
      "nullable": true,
      "description": "related entity (post, comment, order, etc.)"
    },
    {
      "name": "entity_id",
      "type": "string",
      "nullable": true
    },
    {
      "name": "action_url",
      "type": "string",
      "nullable": true,
      "description": "deep link / frontend route"
    },
    {
      "name": "priority",
      "type": "string",
      "nullable": false,
      "default": "normal",
      "description": "low, normal, high, urgent"
    },
    {
      "name": "status",
      "type": "string",
      "nullable": false,
      "default": "unread",
      "description": "unread, read, archived, deleted"
    },
    {
      "name": "channel",
      "type": "string",
      "nullable": false,
      "default": "in_app",
      "description": "in_app, email, sms, push, webhook"
    },
    {
      "name": "metadata",
      "type": "jsonb",
      "nullable": true,
      "default": "{}",
      "description": "extra payload (avatars, counters, custom data)"
    },
    {
      "name": "read_at",
      "type": "datetime",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false
    }
  ],
  "indexes": [
    {
      "name": "idx_notifications_recipient",
      "fields": ["recipient_user_id"]
    },
    {
      "name": "idx_notifications_type",
      "fields": ["type"]
    },
    {
      "name": "idx_notifications_status",
      "fields": ["status"]
    },
    {
      "name": "idx_notifications_entity",
      "fields": ["entity_type", "entity_id"]
    },
    {
      "name": "idx_notifications_created",
      "fields": ["created_at"]
    }
  ],
  "constraints": [
    {
      "type": "foreign_key",
      "fields": ["recipient_user_id"],
      "references": {
        "table": "nxf_saas_users",
        "field": "user_id"
      }
    }
  ]
}