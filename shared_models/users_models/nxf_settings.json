{
  "table_name": "nxf_settings",
  "schema": "public",
  "columns": [
    {
      "name": "setting_id",
      "type": "string",
      "nullable": false,
      "is_primary": true
    },
    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "null = global system setting, otherwise tenant-specific override"
    },
    {
      "name": "setting_key",
      "type": "string",
      "nullable": false,
      "description": "unique setting key (e.g. theme.mode, app.name)"
    },
    {
      "name": "setting_value",
      "type": "jsonb",
      "nullable": true,
      "description": "flexible value storage (string, number, object, array)"
    },
    {
      "name": "value_type",
      "type": "string",
      "nullable": false,
      "default": "string",
      "description": "string, number, boolean, json"
    },
    {
      "name": "category",
      "type": "string",
      "nullable": false,
      "description": "ui, auth, billing, notifications, system, integrations"
    },
    {
      "name": "is_public",
      "type": "boolean",
      "nullable": false,
      "default": false,
      "description": "whether frontend clients can access this setting"
    },
    {
      "name": "is_sensitive",
      "type": "boolean",
      "nullable": false,
      "default": false,
      "description": "marks secrets (API keys, tokens)"
    },
    {
      "name": "description",
      "type": "text",
      "nullable": true
    },
    {
      "name": "updated_by",
      "type": "string",
      "nullable": true,
      "description": "user_id who last changed the setting"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true
    }
  ],
  "indexes": [
    {
      "name": "idx_settings_org",
      "fields": ["organisation_id"]
    },
    {
      "name": "idx_settings_key",
      "fields": ["setting_key"]
    },
    {
      "name": "idx_settings_category",
      "fields": ["category"]
    }
  ],
  "constraints": [
    {
      "type": "unique",
      "fields": ["organisation_id", "setting_value"]
    }
  ]
}