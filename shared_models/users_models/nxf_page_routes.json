{
  "table_name": "nxf_page_routes",
  "schema": "public",
  "columns": [
    {
      "name": "route_id",
      "type": "string",
      "nullable": false,
      "is_primary": true,
      "hidden": true
    },
    {
      "name": "project_id",
      "type": "string",
      "nullable": false,
      "foreign_key": {
        "references": "nxf_system_projects(project_id)"
      },
      "hidden": true
    },
    {
      "name": "tenant_id",
      "type": "string",
      "nullable": false,
      "foreign_key": {
        "references": "nxf_system_tenants(ten_id)"
      },
      "hidden": true
    },
    {
      "name": "from_page_id",
      "type": "string",
      "nullable": false,
      "description": "source page for this navigation route",
      "foreign_key": {
        "references": "nxf_pages(page_id)"
      },
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "to_page_id",
      "type": "string",
      "nullable": false,
      "description": "destination page for this navigation route",
      "foreign_key": {
        "references": "nxf_pages(page_id)"
      },
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "trigger",
      "type": "string",
      "nullable": false,
      "default": "tap",
      "description": "tap | swipe | button | back | timer | auto",
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["tap", "swipe", "button", "back", "timer", "auto"]
    },
    {
      "name": "attach_to",
      "type": "string",
      "nullable": true,
      "description": "nav-icon | footer-link | card-tap | primary-action — where this route's trigger attaches on the source page. nav-icon and footer-link are currently non-functional in codegen (nav_settings already controls the nav bar/footer) — parked post-testing.",
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["nav-icon", "footer-link", "card-tap", "primary-action"]
    },
    {
      "name": "label",
      "type": "string",
      "nullable": true,
      "description": "optional label shown on the route in the Navigator diagram",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "hidden": true
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  ],
  "indexes": [
    { "name": "idx_page_routes_project", "fields": ["project_id"] },
    { "name": "idx_page_routes_from",    "fields": ["from_page_id"] },
    { "name": "idx_page_routes_to",      "fields": ["to_page_id"] }
  ],
  "constraints": []
}