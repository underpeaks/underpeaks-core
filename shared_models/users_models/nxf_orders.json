{
  "table_name": "nxf_orders",
  "primary_key": "ord_id",
  "columns": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },

    "products": {
      "type": "array",
      "items": {
        "type": "string",
        "references": {
          "table": "products",
          "column": "prod_id",
          "on_delete": "CASCADE"
        }
      }
    },
    "product_variants": {
      "type": "array",
      "items": {
        "type": "string",
        "references": {
          "table": "product_variants",
          "column": "pv_id",
          "on_delete": "CASCADE"
        }
      }
    },

    "quantities": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "unit_prices": {
      "type": "array",
      "items": { "type": "double" }
    },
    "total_price": { "type": "double" },

    "status": { "type": "string", "default": "pending" },
    "order_notes": { "type": "string" },

    "shipping_address_line1": { "type": "string" },
    "shipping_address_line2": { "type": "string" },
    "shipping_city": { "type": "string" },
    "shipping_state": { "type": "string" },
    "shipping_postal_code": { "type": "string" },
    "shipping_country": { "type": "string" },

    "billing_address_line1": { "type": "string" },
    "billing_address_line2": { "type": "string" },
    "billing_city": { "type": "string" },
    "billing_state": { "type": "string" },
    "billing_postal_code": { "type": "string" },
    "billing_country": { "type": "string" },

    "shipping_method": { "type": "string" },
    "discount_percentage": { "type": "double" },
    "discount_value": { "type": "double" },

    "estimated_delivery": { "type": "datetime" },
    "delivered_at": { "type": "datetime" },

    "created_at": { "type": "datetime", "required": true },
    "updated_at": { "type": "datetime" },

    "transaction_id": {
      "type": "string",
      "references": {
        "table": "transactions",
        "column": "tran_id",
        "on_delete": "CASCADE"
      }
    }
  }
}
