{
  "table_name": "nxf_pages",
  "schema": "public",
  "columns": [
    {
      "name": "page_id",
      "type": "string",
      "nullable": false,
      "is_primary": true,
      "hidden": true
    },
     {
    "name": "project_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_projects(project_id)"
    },
    "hidden": true
  },
  {
    "name": "tenant_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_tenants(ten_id)"
    },
    "hidden": true
  },
    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "optional tenant scope (null = global page)",
      "hidden": true
    },
    {
      "name": "created_by",
      "type": "string",
      "nullable": false,
      "description": "user_id of page creator",
      "hidden": true
    },
    {
      "name": "title",
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "slug",
      "type": "string",
      "nullable": false,
      "description": "unique URL identifier",
      "hidden": false,
      "ui_type": "slug-input"
    },
    {
      "name": "content",
      "type": "jsonb",
      "nullable": true,
      "description": "flexible page builder blocks / structured content",
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "template_type",
      "type": "string",
      "nullable": false,
      "default": "custom",
      "description": "custom, landing, blog, profile, legal, marketing",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "status",
      "type": "string",
      "nullable": false,
      "default": "draft",
      "description": "draft, published, archived",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "visibility",
      "type": "string",
      "nullable": false,
      "default": "public",
      "description": "public, private, org_only, unlisted",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "seo_title",
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "seo_description",
      "type": "text",
      "nullable": true,
      "hidden": false,
      "ui_type": "textarea"
    },
    {
      "name": "seo_keywords",
      "type": "jsonb",
      "nullable": true,
      "default": "[]",
      "hidden": false,
      "ui_type": "tags-input"
    },
    {
      "name": "featured_image",
      "type": "string",
      "nullable": true,
      "hidden": false,
      "ui_type": "image-upload"
    },
    {
      "name": "custom_css",
      "type": "text",
      "nullable": true,
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "custom_js",
      "type": "text",
      "nullable": true,
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "view_count",
      "type": "integer",
      "nullable": false,
      "default": 0,
      "hidden": false,
      "ui_type": "number-input"
    },
    {
      "name": "published_at",
      "type": "datetime",
      "nullable": true,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "hidden": true
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  ],
  "indexes": [
    { "name": "idx_pages_org", "fields": ["organisation_id"] },
    { "name": "idx_pages_slug", "fields": ["slug"] },
    { "name": "idx_pages_status", "fields": ["status"] },
    { "name": "idx_pages_visibility", "fields": ["visibility"] },
    { "name": "idx_pages_creator", "fields": ["created_by"] }
  ],
  "constraints": [
    {
      "type": "unique",
      "fields": ["organisation_id", "slug"]
    },
    {
      "type": "foreign_key",
      "fields": ["created_by"],
      "references": {
        "table": "nxf_saas_users",
        "field": "user_id"
      }
    }
  ]
}