{
  "table_name": "nxf_menus",
  "schema": "public",
  "columns": [
    {
      "name": "menu_id",
      "type": "string",
      "nullable": false,
      "is_primary": true,
      "hidden": true
    },
     {
    "name": "project_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_projects(project_id)"
    },
    "hidden": true
  },
  {
    "name": "tenant_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_tenants(ten_id)"
    },
    "hidden": true
  },
    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "optional tenant scope (null = global/shared menu)",
      "hidden": true
    },
    {
      "name": "parent_menu_id",
      "type": "string",
      "nullable": true,
      "description": "supports nested menus",
      "hidden": true
    },
    {
      "name": "label",
      "type": "string",
      "nullable": false,
      "description": "display name",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "slug",
      "type": "string",
      "nullable": false,
      "description": "unique identifier for routing",
      "hidden": false,
      "ui_type": "slug-input"
    },
    {
      "name": "icon",
      "type": "string",
      "nullable": true,
      "description": "icon name or svg reference",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "route",
      "type": "string",
      "nullable": true,
      "description": "frontend route (if navigational item)",
      "hidden": false,
      "ui_type": "url-input"
    },
    {
      "name": "type",
      "type": "string",
      "nullable": false,
      "description": "link, group, divider, external",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "platform",
      "type": "string",
      "nullable": false,
      "default": "all",
      "description": "web, mobile, admin, all",
      "hidden": false,
      "ui_type": "select"
    },
    {
      "name": "permission_key",
      "type": "string",
      "nullable": true,
      "description": "RBAC control (ties into roles/permissions system)",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "sort_order",
      "type": "integer",
      "nullable": false,
      "default": 0,
      "hidden": false,
      "ui_type": "number-input"
    },
    {
      "name": "is_visible",
      "type": "boolean",
      "nullable": false,
      "default": true,
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "is_active",
      "type": "boolean",
      "nullable": false,
      "default": true,
      "hidden": false,
      "ui_type": "toggle"
    },
    {
      "name": "metadata",
      "type": "jsonb",
      "nullable": true,
      "default": "{}",
      "description": "flexible config (badges, counters, feature flags, etc.)",
      "hidden": false,
      "ui_type": "code-editor"
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "hidden": true
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  ],
  "indexes": [
    { "name": "idx_menu_org", "fields": ["organisation_id"] },
    { "name": "idx_menu_parent", "fields": ["parent_menu_id"] },
    { "name": "idx_menu_slug", "fields": ["slug"] },
    { "name": "idx_menu_platform", "fields": ["platform"] },
    { "name": "idx_menu_sort", "fields": ["sort_order"] }
  ],
  "constraints": [
    {
      "type": "unique",
      "fields": ["organisation_id", "slug"]
    },
    {
      "type": "foreign_key",
      "fields": ["parent_menu_id"],
      "references": {
        "table": "nxf_menu",
        "field": "menu_id"
      }
    }
  ]
}