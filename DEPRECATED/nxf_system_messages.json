{
  "table_name": "nxf_system_messages",
  "primary_key": "mes_id",
  "columns": {
    "mes_id": {
      "type": "string",
      "hidden": true
    },
    "tenant_id": {
  "type": "string",
  "nullable": false,
  "foreign_key": {
    "references": "nxf_system_tenants(ten_id)",
    "on_delete": "CASCADE"
  },
  "hidden": true
},
"project_id": { "type": "string", "nullable": false, "foreign_key": { "references": "nxf_system_projects(project_id)", "on_delete": "CASCADE" }, "hidden": true },
    "conversation_id": {
      "type": "string",
      "nullable": false,
      "foreign_key": {
        "references": "nxf_conversations(con_id)",
        "on_delete": "CASCADE"
      },
      "hidden": true
    },
    "sender_id": {
      "type": "string",
      "nullable": false,
      "references": {
        "table": "users",
        "column": "user_id",
        "on_delete": "SET NULL"
      },
      "hidden": true
    },
    "recipient_id": {
      "type": "string",
      "nullable": true,
      "references": {
        "table": "users",
        "column": "user_id",
        "on_delete": "SET NULL"
      },
      "hidden": true
    },
    "content": {
      "type": "string",
      "nullable": false,
      "hidden": false,
      "ui_type": "textarea"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "nullable": false,
      "hidden": false,
      "ui_type": "toggle"
    },
    "sent_at": {
      "type": "datetime",
      "nullable": false,
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    "created_at": {
      "type": "datetime",
      "required": true,
      "hidden": true
    },
    "updated_at": {
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  }
}