{
  "table_name": "nxf_user_permisissions",
  "schema": "public",
  "columns": [
    {
      "name": "user_permission_id",
      "type": "string",
      "nullable": false,
      "is_primary": true,
      "hidden": true
    },
    {
      "name": "organisation_id",
      "type": "string",
      "nullable": true,
      "description": "optional SaaS tenant scope (null = global)",
      "hidden": true
    },
     {
    "name": "project_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_projects(project_id)"
    },
    "hidden": true
  },
  {
    "name": "tenant_id",
    "type": "string",
    "nullable": false,
    "foreign_key": {
      "references": "nxf_system_tenants(ten_id)"
    },
    "hidden": true
  },
    {
      "name": "user_id",
      "type": "string",
      "nullable": false,
      "description": "user receiving the permission",
      "hidden": true
    },
    {
      "name": "permission_key",
      "type": "string",
      "nullable": false,
      "description": "e.g. post.create, post.delete, user.ban",
      "hidden": false,
      "ui_type": "textfield"
    },
    {
      "name": "scope_type",
      "type": "string",
      "nullable": true,
      "description": "global, organisation, group, own_resource",
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["global", "organisation", "group", "own_resource"]
    },
    {
      "name": "scope_id",
      "type": "string",
      "nullable": true,
      "description": "id of scoped entity (org_id, group_id, etc.)",
      "hidden": true
    },
    {
      "name": "effect",
      "type": "string",
      "nullable": false,
      "default": "allow",
      "description": "allow or deny (deny overrides allow)",
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["allow", "deny"]
    },
    {
      "name": "source",
      "type": "string",
      "nullable": false,
      "description": "role, direct, system, override",
      "hidden": false,
      "ui_type": "select",
      "options_mode": "manual",
      "options": ["role", "direct", "system", "override"]
    },
    {
      "name": "expires_at",
      "type": "datetime",
      "nullable": true,
      "description": "optional time-limited permission",
      "hidden": false,
      "ui_type": "datetime-picker"
    },
    {
      "name": "created_by",
      "type": "string",
      "nullable": true,
      "description": "admin/system user who granted permission",
      "hidden": true
    },
    {
      "name": "created_at",
      "type": "datetime",
      "nullable": false,
      "hidden": true
    },
    {
      "name": "updated_at",
      "type": "datetime",
      "nullable": true,
      "hidden": true
    }
  ],
  "indexes": [
    { "name": "idx_user_permissions_user", "fields": ["user_id"] },
    { "name": "idx_user_permissions_key", "fields": ["permission_key"] },
    { "name": "idx_user_permissions_scope", "fields": ["scope_type", "scope_id"] },
    { "name": "idx_user_permissions_org", "fields": ["organisation_id"] }
  ],
  "constraints": [
    {
      "type": "unique",
      "fields": ["user_id", "permission_key", "scope_type", "scope_id"]
    }
  ]
}